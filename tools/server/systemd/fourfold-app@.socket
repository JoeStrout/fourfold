# An app's engine socket: only fourfold front (group fourfold-front) may
# connect. The app is /srv/%i; its engine runs as ff-%i.
[Unit]
Description=Fourfold app %i: engine socket

[Socket]
ListenStream=/run/fourfold/%i.sock
SocketUser=ff-%i
SocketGroup=fourfold-front
SocketMode=0660
DirectoryMode=0755

[Install]
WantedBy=sockets.target
