# An app's dropbox writer, as its own OS user (ff-%i-log): the only process
# that can write /srv/%i/dropbox/. It appends what the engine sends.
[Unit]
Description=Fourfold app %i: dropbox writer
Requires=fourfold-dropbox@%i.socket

[Service]
User=ff-%i-log
Group=ff-%i-log
UMask=0027
ExecStart=/usr/local/bin/fourfold dropbox-writer /srv/%i/dropbox
Restart=on-failure
MemoryMax=64M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/%i/dropbox
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes

[Install]
WantedBy=multi-user.target
