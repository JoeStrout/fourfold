# An app's dropbox writer socket: only the app's engine (group ff-%i) may
# connect.
[Unit]
Description=Fourfold app %i: dropbox writer socket

[Socket]
ListenStream=/run/fourfold/%i-dropbox.sock
SocketUser=ff-%i-log
SocketGroup=ff-%i
SocketMode=0660
DirectoryMode=0755

[Install]
WantedBy=sockets.target
